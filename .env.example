# .env.example
# File mẫu chứa các biến môi trường cho docker-compose.yml
# Sao chép file này thành .env và điền các giá trị thực tế

# Môi trường chạy ứng dụng .NET (Development/Production)
ASPNETCORE_ENVIRONMENT=Development

# Cấu hình Database PostgreSQL
POSTGRES_DB=book_management_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

# Connection String cho API
# (Sử dụng tên service 'db' trong Docker Compose để kết nối)
DB_CONNECTION_STRING="Host=db;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

# Cấu hình cho Frontend React
# VITE_API_BASE_URL: URL mà frontend sẽ gọi API
# Khi chạy trong Docker Compose với Nginx proxy, Nginx sẽ định tuyến /api/ đến service 'api'
# Vì vậy, frontend gọi /api/... sẽ được Nginx xử lý
VITE_API_BASE_URL=/api