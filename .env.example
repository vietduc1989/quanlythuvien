# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quanlythuvien_db
DB_USER=postgres
DB_PASSWORD=yourpasswordhere

# Connection String Template for EF Core (PostgreSQL)
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=quanlythuvien_db;Username=postgres;Password=yourpasswordhere"

# JWT Authentication Settings
Jwt__Secret="YourSuperSecretKeyHereWithAtLeast32Characters!"
Jwt__Issuer="ONENET"
Jwt__Audience="quanlythuvien-users"
Jwt__ExpiryInMinutes=60

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
WEB_PORT=3000
