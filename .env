```ini
# .env
# File này chứa các biến môi trường nhạy cảm hoặc cấu hình cho môi trường phát triển cục bộ.
# KHÔNG COMMIT FILE NÀY LÊN REPO CÔNG KHAI!

# Cấu hình Cơ sở dữ liệu (PostgreSQL)
DB_NAME=readermanagement_db
DB_USER=reader_user
DB_PASSWORD=your_strong_password_here

# Cấu hình API (nếu cần biến môi trường cụ thể cho API)
# API_SECRET_KEY=your_api_secret_key_for_dev

# Cấu hình Web (nếu cần biến môi trường cho frontend, ví dụ: endpoint API)
# REACT_APP_API_BASE_URL=http://localhost:8080
```